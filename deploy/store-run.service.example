[Unit]
Description=Store Run household shopping app
After=network.target

[Service]
Type=simple
User=store-run
Group=store-run
WorkingDirectory=/opt/store-run
EnvironmentFile=/etc/store-run.env
ExecStart=/opt/store-run/.venv/bin/waitress-serve --listen=0.0.0.0:8000 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/store-run

[Install]
WantedBy=multi-user.target